{
  "name": "discord-token-launcher",
  "version": "1.0.0",
  "description": "Launcher moderne pour gérer plusieurs comptes Discord via tokens",
  "author": "Yurogin",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.yurogin.discordtokenlauncher",
    "productName": "Discord Token Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
